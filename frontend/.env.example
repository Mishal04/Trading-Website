# API Base URL for backend communication
# In production pointing to custom api subdomain:
VITE_API_URL=https://api.solvextrade.com/api

# If deploying on the same domain behind a reverse proxy (e.g. Nginx / Cloudflare):
# VITE_API_URL=https://solvextrade.com/api

# Maintenance Mode (reversible)
# Set to 'true' to display maintenance page instead of landing page
# Set to 'false' to show normal landing page (default)
VITE_MAINTENANCE_MODE=false
