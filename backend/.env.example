# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Frontend Domain for CORS and email verification links
CLIENT_URL=https://solvextrade.com

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@solvextrade.com
EMAIL_PASS=your_email_app_password

# Admin Seed Configuration (Run: ADMIN_SEED_PASSWORD=yourpass npm run seed:admin)
ADMIN_EMAIL=info.solvex1@gmail.com
ADMIN_SEED_PASSWORD=
